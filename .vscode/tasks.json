{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Workshop",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Run Workshop",
            "type": "shell",
            "command": "${workspaceFolder}\Workshop.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build Workshop",
            "problemMatcher": []
        }
    ]
}
